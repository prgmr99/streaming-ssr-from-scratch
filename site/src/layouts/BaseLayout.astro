---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "React Streaming SSR을 직접 구현하며 정리한 기록" } =
  Astro.props;
---

<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://cdn.jsdelivr.net" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- 본문: 한글 지원 그로테스크 -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css"
    />
    <!-- 데이터·코드: 전부 ASCII라 한글 지원 불필요 -->
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    /* ── 색 ──────────────────────────────────────────
       스트리밍은 "아직 안 온 것"과 "도착한 것"의 대비가 전부다.
       팔레트도 그 두 상태를 중심으로 짰다. */
    --paper: #f6f6f3; /* 배경 */
    --surface: #ffffff; /* 카드·미리보기 */
    --ink: #17191c; /* 본문 */
    --muted: #6a7079; /* 보조 텍스트 */
    --rule: #dfdedd; /* 경계선 */

    --pending: #a8a49c; /* 아직 도착하지 않음 */
    --arrived: #1d4ed8; /* 도착한 chunk */
    --shell: #0f766e; /* shell (첫 덩어리) */

    /* ── 타입 ───────────────────────────────────── */
    --font-sans: "Pretendard Variable", Pretendard, -apple-system, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, monospace;

    /* ── 레이아웃 ────────────────────────────────── */
    --measure: 44rem; /* 본문 폭 */
    --measure-wide: 60rem; /* 시각화 폭 */
  }

  * {
    box-sizing: border-box;
  }

  html {
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.75;
    letter-spacing: -0.011em;
    word-break: keep-all; /* 한글 단어 중간에서 끊기지 않게 */
  }

  /* ── 본문 흐름 ──────────────────────────────────
     마크다운이 그대로 이 안에 들어온다. */
  .prose {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 5rem 1.5rem 8rem;
  }

  .prose > h1 {
    font-size: clamp(2rem, 5vw, 2.75rem);
    line-height: 1.2;
    letter-spacing: -0.03em;
    font-weight: 700;
    margin: 0 0 1rem;
  }

  .prose > h2 {
    font-size: 1.5rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
    font-weight: 700;
    margin: 4.5rem 0 1rem;
    padding-top: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .prose > h3 {
    font-size: 1.125rem;
    font-weight: 600;
    margin: 2.5rem 0 0.5rem;
  }

  .prose > p {
    margin: 0 0 1.25rem;
  }

  .prose > ul,
  .prose > ol {
    margin: 0 0 1.25rem;
    padding-left: 1.25rem;
  }

  .prose li {
    margin-bottom: 0.375rem;
  }

  .prose a {
    color: var(--arrived);
    text-underline-offset: 0.2em;
  }

  .prose strong {
    font-weight: 700;
  }

  /* 인라인 코드 */
  .prose :not(pre) > code {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background: #eceae5;
    padding: 0.15em 0.35em;
    border-radius: 3px;
  }

  /* 코드 블록 — 본문보다 넓게 */
  .prose pre {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: 6px;
    padding: 1.125rem 1.25rem;
    overflow-x: auto;
    margin: 1.75rem 0;
  }

  .prose blockquote {
    margin: 1.75rem 0;
    padding-left: 1.125rem;
    border-left: 2px solid var(--rule);
    color: var(--muted);
  }

  .prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.9375rem;
    margin: 1.75rem 0;
  }

  .prose th,
  .prose td {
    text-align: left;
    padding: 0.5rem 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  .prose th {
    font-weight: 600;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    color: var(--muted);
  }

  /* ── 시각화 자리 ────────────────────────────────
     본문 폭을 넘어 양옆으로 벌어진다. */
  .figure {
    max-width: var(--measure-wide);
    margin: 2.5rem calc((var(--measure) - var(--measure-wide)) / 2);
    width: var(--measure-wide);
  }

  @media (max-width: 64rem) {
    .figure {
      width: 100%;
      max-width: 100%;
      margin: 2.5rem 0;
    }
  }

  :focus-visible {
    outline: 2px solid var(--arrived);
    outline-offset: 2px;
  }
</style>